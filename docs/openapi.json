{
  "openapi": "3.1.0",
  "info": {
    "title": "MotionBase Agent API",
    "version": "2.0.0",
    "description": "Token-authenticated API for AI agents to triage, tag and organise a MotionBase library. All writes are logged and can be reverted from the UI."
  },
  "servers": [
    {
      "url": "/api/agent/v1"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/": {
      "get": {
        "summary": "API index",
        "security": [],
        "responses": {
          "200": {
            "description": "Index"
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI document"
          }
        }
      }
    },
    "/status": {
      "get": {
        "summary": "Counts per review status, lease count, settings, ffmpeg availability",
        "responses": {
          "200": {
            "description": "Status"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/taxonomy": {
      "get": {
        "summary": "Categories (with tags, descriptions, selection mode) and folders",
        "responses": {
          "200": {
            "description": "Taxonomy"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/files": {
      "get": {
        "summary": "List files (cursor pagination by id)",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "untagged",
                "needs_review",
                "agent_reviewed",
                "reviewed",
                "all"
              ],
              "default": "all"
            }
          },
          {
            "name": "folder",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Folder id, folder path (\"A/B\") or \"none\" for unfiled."
          },
          {
            "name": "subfolders",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ],
              "default": "1"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated tag ids (AND across categories, OR within)."
          },
          {
            "name": "search",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "favorites",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "uploader",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "User id of the uploader, or \"none\" for unknown."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "next_cursor from the previous page."
          }
        ],
        "responses": {
          "200": {
            "description": "Page of files",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "files": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/File"
                      }
                    },
                    "total": {
                      "type": "integer"
                    },
                    "next_cursor": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/files/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Get a file",
        "responses": {
          "200": {
            "description": "File",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/File"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "patch": {
        "summary": "Update one file",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "add_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "remove_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "set_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Replace all non-system tags."
                  },
                  "add_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TagRef"
                    },
                    "description": "Add tags by category + name."
                  },
                  "remove_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TagRef"
                    }
                  },
                  "set_category_tags": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "description": "Replace the tags in only the named categories, e.g. {\"Video Type\":[\"Explainer\"]}. An empty array clears the category."
                  },
                  "notes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes_mode": {
                    "type": "string",
                    "enum": [
                      "replace",
                      "append"
                    ],
                    "default": "replace"
                  },
                  "folder_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "null unfiles the file."
                  },
                  "folder_path": {
                    "type": "string",
                    "description": "e.g. \"Brands/Acme\". Created when create_missing is true."
                  },
                  "favorite": {
                    "type": "boolean"
                  },
                  "mark_reviewed": {
                    "type": "boolean",
                    "description": "Stamp agent_reviewed_at; also marks reviewed unless the user requires confirmation."
                  },
                  "create_missing": {
                    "type": "boolean",
                    "default": false,
                    "description": "Create categories, tags and folders that do not exist."
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": false,
                    "description": "Validate and preview; write nothing."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied (see results) plus the updated file"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/files/{id}/frames": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Evenly spaced frame list with timestamps and URLs",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 16,
              "default": 8
            }
          },
          {
            "name": "width",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 1024,
              "default": 640
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Frames"
          },
          "503": {
            "description": "ffmpeg unavailable"
          }
        }
      }
    },
    "/files/{id}/frames/{i}.jpg": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        },
        {
          "name": "i",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "One frame as JPEG",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 16,
              "default": 8
            }
          },
          {
            "name": "width",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 1024,
              "default": 640
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Frame",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Out of range"
          },
          "503": {
            "description": "ffmpeg unavailable"
          }
        }
      }
    },
    "/files/{id}/contact-sheet.jpg": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Grid of evenly spaced frames in one JPEG (longest side <= 1568px). Header X-Frame-Times lists each tile timestamp.",
        "parameters": [
          {
            "name": "count",
            "in": "query",
            "schema": {
              "type": "integer",
              "maximum": 16,
              "default": 9
            }
          },
          {
            "name": "cols",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 3
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact sheet",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "503": {
            "description": "ffmpeg unavailable"
          }
        }
      }
    },
    "/files/{id}/thumbnail.jpg": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer"
          }
        }
      ],
      "get": {
        "summary": "Stored thumbnail",
        "responses": {
          "200": {
            "description": "Thumbnail",
            "content": {
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "No thumbnail"
          }
        }
      }
    },
    "/files/bulk": {
      "post": {
        "summary": "Update up to 500 files atomically (validate all, then apply)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "updates"
                ],
                "properties": {
                  "updates": {
                    "type": "array",
                    "maxItems": 500,
                    "items": {
                      "type": "object",
                      "required": [
                        "file_id"
                      ],
                      "properties": {
                        "file_id": {
                          "type": "integer"
                        },
                        "add_tag_ids": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          }
                        },
                        "remove_tag_ids": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          }
                        },
                        "set_tag_ids": {
                          "type": "array",
                          "items": {
                            "type": "integer"
                          },
                          "description": "Replace all non-system tags."
                        },
                        "add_tags": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/TagRef"
                          },
                          "description": "Add tags by category + name."
                        },
                        "remove_tags": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/TagRef"
                          }
                        },
                        "set_category_tags": {
                          "type": "object",
                          "additionalProperties": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          "description": "Replace the tags in only the named categories, e.g. {\"Video Type\":[\"Explainer\"]}. An empty array clears the category."
                        },
                        "notes": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "notes_mode": {
                          "type": "string",
                          "enum": [
                            "replace",
                            "append"
                          ],
                          "default": "replace"
                        },
                        "folder_id": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "description": "null unfiles the file."
                        },
                        "folder_path": {
                          "type": "string",
                          "description": "e.g. \"Brands/Acme\". Created when create_missing is true."
                        },
                        "favorite": {
                          "type": "boolean"
                        },
                        "mark_reviewed": {
                          "type": "boolean",
                          "description": "Stamp agent_reviewed_at; also marks reviewed unless the user requires confirmation."
                        }
                      }
                    }
                  },
                  "create_missing": {
                    "type": "boolean",
                    "default": false,
                    "description": "Create categories, tags and folders that do not exist."
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": false,
                    "description": "Validate and preview; write nothing."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or previewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/files/apply": {
      "post": {
        "summary": "Apply one identical change to many files",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "file_ids"
                ],
                "properties": {
                  "file_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "add_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "remove_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "set_tag_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    },
                    "description": "Replace all non-system tags."
                  },
                  "add_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TagRef"
                    },
                    "description": "Add tags by category + name."
                  },
                  "remove_tags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/TagRef"
                    }
                  },
                  "set_category_tags": {
                    "type": "object",
                    "additionalProperties": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    },
                    "description": "Replace the tags in only the named categories, e.g. {\"Video Type\":[\"Explainer\"]}. An empty array clears the category."
                  },
                  "notes": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "notes_mode": {
                    "type": "string",
                    "enum": [
                      "replace",
                      "append"
                    ],
                    "default": "replace"
                  },
                  "folder_id": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "null unfiles the file."
                  },
                  "folder_path": {
                    "type": "string",
                    "description": "e.g. \"Brands/Acme\". Created when create_missing is true."
                  },
                  "favorite": {
                    "type": "boolean"
                  },
                  "mark_reviewed": {
                    "type": "boolean",
                    "description": "Stamp agent_reviewed_at; also marks reviewed unless the user requires confirmation."
                  },
                  "create_missing": {
                    "type": "boolean",
                    "default": false,
                    "description": "Create categories, tags and folders that do not exist."
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": false,
                    "description": "Validate and preview; write nothing."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or previewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/files/review": {
      "post": {
        "summary": "Mark files reviewed by the agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "file_ids"
                ],
                "properties": {
                  "file_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "dry_run": {
                    "type": "boolean",
                    "default": false,
                    "description": "Validate and preview; write nothing."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Applied or previewed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationFailed"
          }
        }
      }
    },
    "/queue/claim": {
      "post": {
        "summary": "Lease a batch of files so parallel agents do not overlap",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "limit": {
                    "type": "integer",
                    "maximum": 100,
                    "default": 10
                  },
                  "lease_seconds": {
                    "type": "integer",
                    "minimum": 30,
                    "maximum": 3600,
                    "default": 900
                  },
                  "status": {
                    "type": "string",
                    "default": "pending"
                  },
                  "owner": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Claimed files"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/queue/release": {
      "post": {
        "summary": "Release leases (all of the owner's, or the given file_ids)",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "file_ids": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "owner": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Released count"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/categories": {
      "post": {
        "summary": "Create a category (idempotent)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "selection": {
                    "type": "string",
                    "enum": [
                      "single",
                      "multi"
                    ],
                    "default": "multi"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already existed (created: false)"
          },
          "201": {
            "description": "Created (created: true)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/tags": {
      "post": {
        "summary": "Create a tag (idempotent)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "category_id": {
                    "type": "integer"
                  },
                  "category": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "create_missing": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already existed"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/folders": {
      "post": {
        "summary": "Create a folder path (idempotent)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "example": "Brands/Acme"
                  },
                  "name": {
                    "type": "string"
                  },
                  "parent_id": {
                    "type": "integer"
                  },
                  "parent_path": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Already existed"
          },
          "201": {
            "description": "Created"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/activity": {
      "get": {
        "summary": "Recent agent writes (newest first)",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "id",
            "in": "query",
            "schema": {
              "type": "integer"
            },
            "description": "Return one entry with before/after snapshots."
          }
        ],
        "responses": {
          "200": {
            "description": "Activity"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token created in Settings > Agent API (mb_...), or AGENT_API_TOKEN."
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or invalid bearer token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "Nothing was applied; per-item errors listed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "error": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "index": {
                        "type": "integer"
                      },
                      "file_id": {
                        "type": "integer"
                      },
                      "errors": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "TagRef": {
        "type": "object",
        "required": [
          "category",
          "name"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "File": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "filename": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "file_type": {
            "enum": [
              "video",
              "image"
            ]
          },
          "duration": {
            "type": [
              "number",
              "null"
            ]
          },
          "width": {
            "type": [
              "integer",
              "null"
            ]
          },
          "height": {
            "type": [
              "integer",
              "null"
            ]
          },
          "fps": {
            "type": [
              "number",
              "null"
            ]
          },
          "aspect_ratio": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "is_favorite": {
            "type": "boolean"
          },
          "uploader": {
            "type": [
              "string",
              "null"
            ],
            "description": "Display name of the user who added the file; null when unknown."
          },
          "upload_source": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "user",
              "import",
              "scan",
              null
            ]
          },
          "folder_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "folder_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "source": {
                  "enum": [
                    "user",
                    "agent",
                    "system"
                  ]
                }
              }
            }
          },
          "tags_by_category": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "review": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "needs_review",
                  "reviewed"
                ]
              },
              "reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reviewed_by": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "agent_reviewed_at": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "lease": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "owner": {
                "type": "string"
              },
              "until": {
                "type": "string"
              }
            }
          },
          "urls": {
            "type": "object",
            "properties": {
              "thumbnail": {
                "type": "string"
              },
              "frames": {
                "type": "string"
              },
              "contact_sheet": {
                "type": "string"
              }
            }
          }
        }
      },
      "BatchResult": {
        "type": "object",
        "properties": {
          "dry_run": {
            "type": "boolean"
          },
          "applied": {
            "type": "integer"
          },
          "unchanged": {
            "type": "integer"
          },
          "activity_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Revert from the UI (POST /api/activity/{id}/revert)."
          },
          "created": {
            "type": "object",
            "properties": {
              "categories": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "folders": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file_id": {
                  "type": "integer"
                },
                "changed": {
                  "type": "boolean"
                },
                "tags_added": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "tags_removed": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
